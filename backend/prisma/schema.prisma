  BRAKES
  SUSPENSION
  STEERING
  ENGINE
  TRANSMISSION
  ELECTRICAL
  BATTERY
  TIRES
  AIR_CONDITIONING
  FLUIDS
  BODY
  INTERIOR
  SAFETY
  OTHER
}

enum PdcFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PreliminaryVehicleDiagnostic {
  id               String                      @id @default(uuid()) @db.Uuid
  companyId        String                      @db.Uuid
  branchId         String                      @db.Uuid
  workOrderId      String                      @db.Uuid
  vehicleId        String                      @db.Uuid
  technicianUserId String                      @db.Uuid
  status           PreliminaryDiagnosticStatus @default(DRAFT)
  startedAt        DateTime                    @default(now())
  completedAt      DateTime?
  mileage          Int?
  generalNotes     String?                     @db.Text
  operationKey     String?                     @db.VarChar(120)
  findingCounter   Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch       @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  workOrder  WorkOrder    @relation(fields: [workOrderId, companyId], references: [id, companyId], onDelete: Restrict)
  vehicle    Vehicle      @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  technician User         @relation("PdcTechnician", fields: [technicianUserId, companyId], references: [id, companyId], onDelete: Restrict)
  findings   PdcFinding[]

  @@unique([id, companyId])
  @@unique([companyId, workOrderId, operationKey])
  @@index([companyId, workOrderId, status])
}

model PdcFinding {
  id                         String                     @id @default(uuid()) @db.Uuid
  companyId                  String                     @db.Uuid
  pdcId                      String                     @db.Uuid
  category                   PdcFindingCategory
  location                   CheckInDamageLocation?
  status                     ChecklistObservationStatus @default(ISSUE)
  severity                   PdcFindingSeverity
  description                String                     @db.Text
  recommendation             String?                    @db.Text
  requiresImmediateAttention Boolean                    @default(false)
  sequence                   Int
  createdByUserId            String                     @db.Uuid
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  company   Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  pdc       PreliminaryVehicleDiagnostic @relation(fields: [pdcId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User                         @relation("PdcFindingCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([companyId, pdcId, sequence])
}
