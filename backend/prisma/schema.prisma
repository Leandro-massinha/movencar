  PDC
  ROAD_TEST_INITIAL
  ROAD_TEST_FINAL
  DELIVERY
  MECHANICAL_INSPECTION
  ELECTRICAL_INSPECTION
  DETAILING
  BODY_SHOP
  TIRES
  CUSTOM
}

enum ChecklistResponseType {
  STATUS
  BOOLEAN
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  MEASUREMENT
  PHOTO
  SIGNATURE
}

enum ChecklistObservationStatus {
  OK
  ISSUE
  NOT_CHECKED
  NOT_APPLICABLE
}

enum ChecklistInstanceStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model ChecklistTemplate {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String?               @db.Uuid
  name        String                @db.VarChar(160)
  description String?               @db.Text
  type        ChecklistTemplateType
  version     Int
  isActive    Boolean               @default(true)
  isDefault   Boolean               @default(false)
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  company   Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sections  ChecklistTemplateSection[]
  instances ChecklistInstance[]

  @@unique([id, version])
  @@unique([companyId, type, version, name])
  @@index([companyId, type, isActive])
}

model ChecklistTemplateSection {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  title       String   @db.VarChar(160)
  description String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())

  template ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  items    ChecklistTemplateItem[]

  @@unique([templateId, order])
}

model ChecklistTemplateItem {
  id                   String                @id @default(uuid()) @db.Uuid
  sectionId            String                @db.Uuid
  title                String                @db.VarChar(180)
  description          String?               @db.Text
  responseType         ChecklistResponseType
  order                Int
  isRequired           Boolean               @default(false)
  requiresPhoto        Boolean               @default(false)
  photoRequiredOnIssue Boolean               @default(false)
  allowNotes           Boolean               @default(true)
  active               Boolean               @default(true)
  options              Json?
  createdAt            DateTime              @default(now())

  section ChecklistTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  results ChecklistItemResult[]

  @@unique([sectionId, order])
}

model ChecklistInstance {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @db.Uuid
  workOrderId     String                  @db.Uuid
  checkInId       String                  @db.Uuid
  templateId      String                  @db.Uuid
  templateVersion Int
  status          ChecklistInstanceStatus @default(DRAFT)
  startedAt       DateTime                @default(now())
  completedAt     DateTime?
  createdByUserId String                  @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workOrder WorkOrder             @relation(fields: [workOrderId, companyId], references: [id, companyId], onDelete: Restrict)
  checkIn   VehicleCheckIn        @relation(fields: [checkInId, companyId], references: [id, companyId], onDelete: Restrict)
  template  ChecklistTemplate     @relation(fields: [templateId, templateVersion], references: [id, version], onDelete: Restrict)
  createdBy User                  @relation("ChecklistInstanceCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  results   ChecklistItemResult[]
  evidenceAttachments ChecklistItemEvidenceAttachment[]

  @@unique([id, companyId])
  @@unique([checkInId, companyId])
  @@index([companyId, workOrderId])
}

model ChecklistItemResult {
  id                String                      @id @default(uuid()) @db.Uuid
  companyId         String                      @db.Uuid
  instanceId        String                      @db.Uuid
  itemId            String                      @db.Uuid
  status            ChecklistObservationStatus?
  textValue         String?                     @db.Text
  numericValue      Decimal?                    @db.Decimal(14, 3)
  selectedValue     String?                     @db.VarChar(240)
  note              String?                     @db.Text
  completedByUserId String                      @db.Uuid
  completedAt       DateTime                    @default(now())
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  instance    ChecklistInstance     @relation(fields: [instanceId, companyId], references: [id, companyId], onDelete: Restrict)
  item        ChecklistTemplateItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  completedBy User                  @relation("ChecklistResultCompleter", fields: [completedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  evidenceAttachments ChecklistItemEvidenceAttachment[]

  @@unique([companyId, instanceId, itemId])
  @@unique([id, instanceId, itemId, companyId])
}

