generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum CompanyModuleStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

model Company {
  id                               String                            @id @default(uuid()) @db.Uuid
  code                             String                            @unique @db.VarChar(60)
  legalName                        String                            @db.VarChar(180)
  tradeName                        String                            @db.VarChar(180)
  document                         String?                           @db.VarChar(30)
  status                           RecordStatus                      @default(ACTIVE)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  deletedAt                        DateTime?
  branches                         Branch[]
  users                            User[]
  roles                            Role[]
  sessions                         UserSession[]
  auditLogs                        AuditLog[]
  resources                        TenantTestResource[]
  customers                        Customer[]
  customerAddresses                CustomerAddress[]
  vehicles                         Vehicle[]
  companyModules                   CompanyModule[]
  vehicleHistory                   VehicleHistoryEvent[]
  vehicleOwnerships                VehicleOwnershipHistory[]
  odometerReadings                 VehicleOdometerReading[]
  workOrders                       WorkOrder[]
  workOrderSequence                WorkOrderSequence?
  customerConcerns                 CustomerConcern[]
  vehicleCheckIns                  VehicleCheckIn[]
  customerIdentityProfiles         CustomerIdentityProfile[]
  customerContacts                 CustomerContact[]
  customerFiscalProfiles           CustomerFiscalProfile[]
  customerRelationships            CustomerRelationship[]
  customerCommunicationPreferences CustomerCommunicationPreference[]
  customerConsents                 CustomerConsent[]
  checklistTemplates               ChecklistTemplate[]
  checklistInstances               ChecklistInstance[]
  checklistResults                 ChecklistItemResult[]
  checkInDamages                   CheckInDamage[]
  fileAssets                       FileAsset[]
  checkInEvidenceAttachments       CheckInEvidenceAttachment[]
  checkInDamageEvidenceAttachments CheckInDamageEvidenceAttachment[]
  checklistItemEvidenceAttachments ChecklistItemEvidenceAttachment[]
  preliminaryDiagnostics           PreliminaryVehicleDiagnostic[]
  pdcFindings                      PdcFinding[]
}

model Module {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(80)
  name        String       @db.VarChar(120)
  description String?
  status      ModuleStatus @default(ACTIVE)
  isCore      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  companies CompanyModule[]
}

model CompanyModule {
  companyId     String              @db.Uuid
  moduleId      String              @db.Uuid
  status        CompanyModuleStatus @default(ACTIVE)
  activatedAt   DateTime            @default(now())
  expiresAt     DateTime?
  configuration Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([companyId, moduleId])
  @@index([companyId, status])
  @@index([moduleId, status])
}

model Branch {
  id                     String                         @id @default(uuid()) @db.Uuid
  companyId              String                         @db.Uuid
  code                   String                         @db.VarChar(40)
  name                   String                         @db.VarChar(140)
  status                 RecordStatus                   @default(ACTIVE)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  deletedAt              DateTime?
  company                Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  users                  User[]
  auditLogs              AuditLog[]
  resources              TenantTestResource[]
  customersOrigin        Customer[]                     @relation("CustomerOriginBranch")
  vehiclesOrigin         Vehicle[]                      @relation("VehicleOriginBranch")
  vehicleHistory         VehicleHistoryEvent[]
  odometerReadings       VehicleOdometerReading[]
  workOrders             WorkOrder[]
  vehicleCheckIns        VehicleCheckIn[]
  preliminaryDiagnostics PreliminaryVehicleDiagnostic[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
}

model User {
  id                        String                         @id @default(uuid()) @db.Uuid
  companyId                 String                         @db.Uuid
  defaultBranchId           String                         @db.Uuid
  name                      String                         @db.VarChar(140)
  email                     String                         @db.VarChar(180)
  passwordHash              String
  status                    UserStatus                     @default(ACTIVE)
  failedLoginAttempts       Int                            @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  deletedAt                 DateTime?
  company                   Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultBranch             Branch                         @relation(fields: [defaultBranchId], references: [id], onDelete: Restrict)
  roles                     UserRole[]
  sessions                  UserSession[]
  auditLogs                 AuditLog[]                     @relation("AuditActor")
  vehicleHistory            VehicleHistoryEvent[]          @relation("VehicleHistoryActor")
  vehicleOwnerships         VehicleOwnershipHistory[]      @relation("VehicleOwnershipActor")
  odometerReadings          VehicleOdometerReading[]       @relation("VehicleOdometerActor")
  attendedWorkOrders        WorkOrder[]                    @relation("WorkOrderAttendant")
  reportedConcerns          CustomerConcern[]              @relation("CustomerConcernReporter")
  createdCheckIns           VehicleCheckIn[]               @relation("VehicleCheckInCreator")
  recordedCustomerConsents  CustomerConsent[]              @relation("CustomerConsentRecorder")
  createdChecklistInstances ChecklistInstance[]            @relation("ChecklistInstanceCreator")
  completedChecklistResults ChecklistItemResult[]          @relation("ChecklistResultCompleter")
  observedCheckInDamages    CheckInDamage[]                @relation("CheckInDamageObserver")
  preliminaryDiagnostics    PreliminaryVehicleDiagnostic[] @relation("PdcTechnician")
  createdPdcFindings        PdcFinding[]                   @relation("PdcFindingCreator")
  uploadedFileAssets                FileAsset[]                       @relation("FileAssetUploader")
  createdCheckInEvidenceAttachments CheckInEvidenceAttachment[]       @relation("CheckInEvidenceAttachmentCreator")
  createdDamageEvidenceAttachments  CheckInDamageEvidenceAttachment[] @relation("CheckInDamageEvidenceAttachmentCreator")
  createdChecklistItemEvidenceAttachments ChecklistItemEvidenceAttachment[] @relation("ChecklistItemEvidenceAttachmentCreator")

  @@unique([id, companyId])
  @@index([companyId, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String?          @db.Uuid
  code        String           @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(64)
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(120)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, revokedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  branchId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(100)
  metadata    Json?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model TenantTestResource {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  branchId  String   @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId, branchId])
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  originBranchId String? @db.Uuid

  type   CustomerType   @default(INDIVIDUAL)
  status CustomerStatus @default(ACTIVE)

  name      String  @db.VarChar(180)
  tradeName String? @db.VarChar(180)

  document          String? @db.VarChar(30)
  stateRegistration String? @db.VarChar(40)

  email    String? @db.VarChar(180)
  phone    String? @db.VarChar(30)
  whatsapp String? @db.VarChar(30)

  birthDate DateTime? @db.Date
  notes     String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  originBranch Branch? @relation("CustomerOriginBranch", fields: [originBranchId, companyId], references: [id, companyId], onDelete: Restrict)

  addresses               CustomerAddress[]
  vehicles                Vehicle[]
  vehicleOwnerships       VehicleOwnershipHistory[]
  workOrders              WorkOrder[]
  vehicleCheckIns         VehicleCheckIn[]
  identityProfile         CustomerIdentityProfile?
  contacts                CustomerContact[]
  fiscalProfile           CustomerFiscalProfile?
  outgoingRelationships   CustomerRelationship[]           @relation("CustomerRelationshipSource")
  incomingRelationships   CustomerRelationship[]           @relation("CustomerRelationshipTarget")
  communicationPreference CustomerCommunicationPreference?
  consents                CustomerConsent[]

  @@unique([id, companyId])
  @@index([companyId, name])
  @@index([companyId, status])
  @@index([companyId, phone])
  @@index([companyId, whatsapp])
  @@index([companyId, deletedAt])
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum FuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
  GNV
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  AUTOMATED
  OTHER
}

model Vehicle {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  customerId     String  @db.Uuid
  originBranchId String? @db.Uuid

  status VehicleStatus @default(ACTIVE)

  plate   String? @db.VarChar(7)
  renavam String? @db.VarChar(11)
  chassis String? @db.VarChar(17)

  brand   String  @db.VarChar(80)
  model   String  @db.VarChar(120)
  version String? @db.VarChar(120)

  yearManufacture Int?
  yearModel       Int?
  color           String? @db.VarChar(60)

  fuelType     FuelType?
  transmission TransmissionType?
  engine       String?           @db.VarChar(80)
  enginePower  Int?
  bodyType     String?           @db.VarChar(80)
  doors        Int?

  currentMileage Int?
  notes          String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company                Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer               Customer                       @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  originBranch           Branch?                        @relation("VehicleOriginBranch", fields: [originBranchId, companyId], references: [id, companyId], onDelete: Restrict)
  history                VehicleHistoryEvent[]
  ownerships             VehicleOwnershipHistory[]
  odometerReadings       VehicleOdometerReading[]
  workOrders             WorkOrder[]
  vehicleCheckIns        VehicleCheckIn[]
  checkInDamages         CheckInDamage[]
  preliminaryDiagnostics PreliminaryVehicleDiagnostic[]

  @@unique([id, companyId])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, brand, model])
  @@index([companyId, originBranchId])
  @@index([companyId, deletedAt])
}

enum VehicleOwnershipType {
  OWNER
  FLEET
  DRIVER
  RESPONSIBLE
  LEASED
  OTHER
}

model VehicleOwnershipHistory {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @db.Uuid
  vehicleId       String               @db.Uuid
  customerId      String               @db.Uuid
  createdByUserId String?              @db.Uuid
  ownershipType   VehicleOwnershipType @default(OWNER)
  validFrom       DateTime
  validUntil      DateTime?
  isCurrent       Boolean              @default(true)
  notes           String?              @db.Text
  createdAt       DateTime             @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle   Vehicle  @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("VehicleOwnershipActor", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, vehicleId, validFrom])
  @@index([companyId, customerId, validFrom])
}

enum VehicleOdometerSource {
  VEHICLE
  VEHICLE_HISTORY
  SERVICE_VISIT
  CHECK_IN
  WORK_ORDER
  INSPECTION
  DELIVERY
  MANUAL
  INTEGRATION
}

model VehicleOdometerReading {
  id         String                @id @default(uuid()) @db.Uuid
  companyId  String                @db.Uuid
  vehicleId  String                @db.Uuid
  branchId   String?               @db.Uuid
  userId     String?               @db.Uuid
  mileage    Int
  recordedAt DateTime
  source     VehicleOdometerSource
  sourceId   String?               @db.VarChar(100)
  notes      String?               @db.Text
  createdAt  DateTime              @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  user    User?   @relation("VehicleOdometerActor", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, vehicleId, recordedAt])
  @@index([companyId, source, sourceId])
}

enum VehicleHistoryEventType {
  VEHICLE_CREATED
  VEHICLE_UPDATED
  MILEAGE_RECORDED
  NOTE
  OWNER_CHANGED
  GENERAL
  WORK_ORDER_OPENED
  CUSTOMER_CONCERN_RECORDED
  CHECK_IN_COMPLETED
  DAMAGE_RECORDED
  PDC_STARTED
  PDC_COMPLETED
  WORK_ORDER_CLOSED_NO_SERVICE
  WORK_ORDER_COMPLETED
  WORK_ORDER_CANCELLED
}

enum VehicleHistorySourceType {
  MANUAL
  SYSTEM
  VEHICLE
  FUTURE_MODULE
}

model VehicleHistoryEvent {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  vehicleId   String  @db.Uuid
  branchId    String? @db.Uuid
  actorUserId String? @db.Uuid

  eventType  VehicleHistoryEventType
  sourceType VehicleHistorySourceType
  sourceId   String?                  @db.VarChar(100)

  title       String   @db.VarChar(180)
  description String?  @db.Text
  mileage     Int?
  eventDate   DateTime
  metadata    Json?
  isManual    Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  actor   User?   @relation("VehicleHistoryActor", fields: [actorUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, vehicleId, eventDate])
  @@index([companyId, vehicleId, eventType])
}

model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @db.Uuid
  customerId String @db.Uuid

  label        String?             @db.VarChar(80)
  type         CustomerAddressType @default(OTHER)
  postalCode   String?             @db.VarChar(20)
  street       String              @db.VarChar(180)
  number       String?             @db.VarChar(30)
  complement   String?             @db.VarChar(120)
  neighborhood String?             @db.VarChar(120)
  city         String              @db.VarChar(120)
  state        String              @db.VarChar(40)
  country      String              @default("BR") @db.VarChar(2)
  reference    String?             @db.VarChar(180)
  ibgeCode     String?             @db.VarChar(7)

  isPrimary Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer       Customer                @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)
  fiscalProfiles CustomerFiscalProfile[]

  @@unique([id, companyId])
  @@unique([id, companyId, customerId])
  @@index([companyId, customerId])
  @@index([companyId, city, state])
}

enum CustomerAddressType {
  HOME
  COMMERCIAL
  FISCAL
  BILLING
  DELIVERY
  OTHER
}

enum CustomerContactType {
  PHONE
  WHATSAPP
  EMAIL
}

enum CustomerContactPurpose {
  PERSONAL
  COMMERCIAL
  FINANCIAL
  ADMINISTRATIVE
  FLEET
  EMERGENCY
  OTHER
}

enum ContactVerificationSource {
  MANUAL
  EMAIL_LINK
  WHATSAPP
  SMS
  CUSTOMER_PORTAL
  INTEGRATION
}

model CustomerIdentityProfile {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  customerId    String    @db.Uuid
  rgNumber      String?   @db.VarChar(40)
  rgIssuer      String?   @db.VarChar(40)
  rgIssuerState String?   @db.VarChar(2)
  rgIssuedAt    DateTime? @db.Date
  socialName    String?   @db.VarChar(180)
  nationality   String?   @db.VarChar(80)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([customerId, companyId])
  @@index([companyId, customerId])
}

model CustomerContact {
  id                 String                     @id @default(uuid()) @db.Uuid
  companyId          String                     @db.Uuid
  customerId         String                     @db.Uuid
  type               CustomerContactType
  label              String?                    @db.VarChar(80)
  value              String                     @db.VarChar(180)
  normalizedValue    String                     @db.VarChar(180)
  purpose            CustomerContactPurpose     @default(PERSONAL)
  isPrimary          Boolean                    @default(false)
  isVerified         Boolean                    @default(false)
  verifiedAt         DateTime?
  verificationSource ContactVerificationSource?
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, customerId, type, isActive])
  @@index([companyId, normalizedValue, isActive])
}

enum TaxpayerIndicator {
  TAXPAYER
  EXEMPT
  NON_TAXPAYER
  UNKNOWN
}

model CustomerFiscalProfile {
  id                    String            @id @default(uuid()) @db.Uuid
  companyId             String            @db.Uuid
  customerId            String            @db.Uuid
  taxpayerIndicator     TaxpayerIndicator @default(UNKNOWN)
  stateRegistration     String?           @db.VarChar(40)
  municipalRegistration String?           @db.VarChar(40)
  fiscalAddressId       String?           @db.Uuid
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer      Customer         @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  fiscalAddress CustomerAddress? @relation(fields: [fiscalAddressId, companyId, customerId], references: [id, companyId, customerId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([customerId, companyId])
  @@index([companyId, customerId])
  @@index([companyId, fiscalAddressId])
}

enum CustomerRelationshipType {
  SPOUSE
  FAMILY_MEMBER
  EMPLOYEE
  DRIVER
  FLEET_MANAGER
  FINANCIAL_RESPONSIBLE
  AUTHORIZED_CONTACT
  LEGAL_REPRESENTATIVE
  OTHER
}

model CustomerRelationship {
  id               String                   @id @default(uuid()) @db.Uuid
  companyId        String                   @db.Uuid
  sourceCustomerId String                   @db.Uuid
  targetCustomerId String                   @db.Uuid
  type             CustomerRelationshipType
  validFrom        DateTime                 @default(now())
  validUntil       DateTime?
  notes            String?                  @db.Text
  createdAt        DateTime                 @default(now())

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceCustomer Customer @relation("CustomerRelationshipSource", fields: [sourceCustomerId, companyId], references: [id, companyId], onDelete: Restrict)
  targetCustomer Customer @relation("CustomerRelationshipTarget", fields: [targetCustomerId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, sourceCustomerId, validFrom])
  @@index([companyId, targetCustomerId, validFrom])
}

enum CustomerPreferredChannel {
  PHONE
  WHATSAPP
  EMAIL
  NONE
}

model CustomerCommunicationPreference {
  id                         String                   @id @default(uuid()) @db.Uuid
  companyId                  String                   @db.Uuid
  customerId                 String                   @db.Uuid
  preferredChannel           CustomerPreferredChannel @default(NONE)
  acceptsOperationalCalls    Boolean                  @default(true)
  acceptsOperationalWhatsapp Boolean                  @default(true)
  acceptsOperationalEmail    Boolean                  @default(true)
  preferredTime              String?                  @db.VarChar(120)
  notes                      String?                  @db.Text
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([customerId, companyId])
  @@index([companyId, customerId])
}

enum CustomerConsentType {
  PRIVACY_POLICY
  MARKETING_WHATSAPP
  MARKETING_EMAIL
  MARKETING_SMS
  DATA_PROCESSING
  CUSTOMER_PORTAL_TERMS
  OTHER
}

enum CustomerConsentStatus {
  GRANTED
  REVOKED
}

enum CustomerConsentSource {
  IN_PERSON
  REMOTE_LINK
  CUSTOMER_PORTAL
  WHATSAPP_LINK
  EMAIL_LINK
  IMPORT
  OTHER
}

model CustomerConsent {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @db.Uuid
  customerId       String                @db.Uuid
  type             CustomerConsentType
  version          String                @db.VarChar(40)
  status           CustomerConsentStatus
  grantedAt        DateTime?
  revokedAt        DateTime?
  source           CustomerConsentSource
  recordedByUserId String                @db.Uuid
  notes            String?               @db.Text
  operationKey     String?               @db.VarChar(120)
  createdAt        DateTime              @default(now())

