model WorkOrder {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @db.Uuid
  branchId        String                  @db.Uuid
  customerId      String                  @db.Uuid
  vehicleId       String                  @db.Uuid
  attendantUserId String                  @db.Uuid
  number          Int
  purpose         WorkOrderPurpose
  status          WorkOrderStatus         @default(OPEN)
  openedAt        DateTime                @default(now())
  closedAt        DateTime?
  mileageAtEntry  Int?
  notes           String?                 @db.Text
  closingReason   WorkOrderClosingReason?
  closingNotes    String?                 @db.Text
  operationKey    String?                 @db.VarChar(120)
  concernCounter  Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company                Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                 Branch                         @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
