enum FileStorageProvider {
  LOCAL_PRIVATE
}

enum FileAssetStatus {
  PENDING
  AVAILABLE
  FAILED
  DELETED
}

enum FileAssetOwnershipType {
  CHECK_IN
  CHECK_IN_DAMAGE
  CHECKLIST_ITEM
}

enum CheckInEvidenceCategory {
  FRONT
  REAR
  LEFT_SIDE
  RIGHT_SIDE
  DASHBOARD
  ODOMETER
  FUEL
  INTERIOR_FRONT
  INTERIOR_REAR
  TRUNK
  ENGINE_BAY
  OTHER
}

model FileAsset {
  id                 String                  @id @default(uuid()) @db.Uuid
  companyId          String                  @db.Uuid
  storageProvider    FileStorageProvider     @default(LOCAL_PRIVATE)
  storageKey         String                  @unique @db.VarChar(500)
  originalFilename   String                  @db.VarChar(255)
  declaredMimeType   String                  @db.VarChar(120)
  detectedMimeType   String                  @db.VarChar(120)
  canonicalExtension String                  @db.VarChar(16)
  sizeBytes          BigInt                  @db.BigInt
  sha256             String                  @db.VarChar(64)
  status             FileAssetStatus         @default(PENDING)
  ownershipType      FileAssetOwnershipType?
  uploadedByUserId   String                  @db.Uuid
  availableAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  company            Company                           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy         User                              @relation("FileAssetUploader", fields: [uploadedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  checkInAttachments CheckInEvidenceAttachment[]
  damageAttachments  CheckInDamageEvidenceAttachment[]
  checklistItemAttachments ChecklistItemEvidenceAttachment[]

  @@unique([id, companyId])
  @@unique([id, companyId, ownershipType])
  @@index([companyId, status, createdAt])
  @@index([companyId, sha256])
  @@index([companyId, deletedAt])
}

model CheckInEvidenceAttachment {
  id                String                  @id @default(uuid()) @db.Uuid
  companyId         String                  @db.Uuid
  checkInId         String                  @db.Uuid
  fileAssetId       String                  @unique @db.Uuid
  fileOwnershipType FileAssetOwnershipType  @default(CHECK_IN)
  category          CheckInEvidenceCategory
  caption           String?                 @db.VarChar(500)
  sequence          Int
  createdByUserId   String                  @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  checkIn   VehicleCheckIn @relation(fields: [checkInId, companyId], references: [id, companyId], onDelete: Restrict)
  fileAsset FileAsset      @relation(fields: [fileAssetId, companyId, fileOwnershipType], references: [id, companyId, ownershipType], onDelete: Restrict, map: "CIEA_file_company_owner_fkey")
  createdBy User           @relation("CheckInEvidenceAttachmentCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, checkInId, category, sequence], map: "CIEA_company_checkin_category_sequence_idx")
  @@index([companyId, deletedAt])
}

model CheckInDamageEvidenceAttachment {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @db.Uuid
  checkInId         String                 @db.Uuid
  damageId          String                 @db.Uuid
  fileAssetId       String                 @unique @db.Uuid
  fileOwnershipType FileAssetOwnershipType @default(CHECK_IN_DAMAGE)
  caption           String?                @db.VarChar(500)
  sequence          Int
  createdByUserId   String                 @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  checkIn   VehicleCheckIn @relation(fields: [checkInId, companyId], references: [id, companyId], onDelete: Restrict)
  damage    CheckInDamage  @relation(fields: [damageId, checkInId, companyId], references: [id, checkInId, companyId], onDelete: Restrict, map: "CIDEA_damage_checkin_company_fkey")
  fileAsset FileAsset      @relation(fields: [fileAssetId, companyId, fileOwnershipType], references: [id, companyId, ownershipType], onDelete: Restrict, map: "CIDEA_file_company_owner_fkey")
  createdBy User           @relation("CheckInDamageEvidenceAttachmentCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, checkInId, damageId, sequence], map: "CIDEA_company_checkin_damage_sequence_idx")
  @@index([companyId, deletedAt])
}

model ChecklistItemEvidenceAttachment {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @db.Uuid
  checkInId         String                 @db.Uuid
  checklistInstanceId String               @db.Uuid
  checklistItemId   String                 @db.Uuid
  itemResultId      String                 @db.Uuid
  fileAssetId       String                 @unique @db.Uuid
  fileOwnershipType FileAssetOwnershipType @default(CHECKLIST_ITEM)
  caption           String?                @db.VarChar(500)
  sequence          Int
  createdByUserId   String                 @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  checkIn   VehicleCheckIn      @relation(fields: [checkInId, companyId], references: [id, companyId], onDelete: Restrict)
  checklistInstance ChecklistInstance @relation(fields: [checklistInstanceId, companyId], references: [id, companyId], onDelete: Restrict)
  itemResult ChecklistItemResult @relation(fields: [itemResultId, checklistInstanceId, checklistItemId, companyId], references: [id, instanceId, itemId, companyId], onDelete: Restrict, map: "CIIEA_result_instance_item_company_fkey")
  fileAsset FileAsset           @relation(fields: [fileAssetId, companyId, fileOwnershipType], references: [id, companyId, ownershipType], onDelete: Restrict, map: "CIIEA_file_company_owner_fkey")
  createdBy User                @relation("ChecklistItemEvidenceAttachmentCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, checkInId, checklistInstanceId, itemResultId, sequence], map: "CIIEA_company_checkin_instance_result_sequence_idx")
  @@index([companyId, deletedAt])
}

enum PreliminaryDiagnosticStatus {
  DRAFT
