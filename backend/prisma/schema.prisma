  @@unique([companyId, operationKey])
  @@index([companyId, status, openedAt])
  @@index([companyId, vehicleId, openedAt])
  @@index([companyId, customerId, openedAt])
  @@index([companyId, branchId, openedAt])
}

enum CustomerConcernPriority {
