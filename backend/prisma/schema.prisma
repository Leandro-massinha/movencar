generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum CompanyModuleStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

model Company {
  id                String                    @id @default(uuid()) @db.Uuid
  code              String                    @unique @db.VarChar(60)
  legalName         String                    @db.VarChar(180)
  tradeName         String                    @db.VarChar(180)
  document          String?                   @db.VarChar(30)
  status            RecordStatus              @default(ACTIVE)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  branches          Branch[]
  users             User[]
  roles             Role[]
  sessions          UserSession[]
  auditLogs         AuditLog[]
  resources         TenantTestResource[]
  customers         Customer[]
  customerAddresses CustomerAddress[]
  vehicles          Vehicle[]
  companyModules    CompanyModule[]
  vehicleHistory    VehicleHistoryEvent[]
  vehicleOwnerships VehicleOwnershipHistory[]
  odometerReadings  VehicleOdometerReading[]
  workOrders        WorkOrder[]
  workOrderSequence WorkOrderSequence?
  customerConcerns  CustomerConcern[]
  vehicleCheckIns   VehicleCheckIn[]
}

model Module {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(80)
  name        String       @db.VarChar(120)
  description String?
  status      ModuleStatus @default(ACTIVE)
  isCore      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  companies CompanyModule[]
}

model CompanyModule {
  companyId     String              @db.Uuid
  moduleId      String              @db.Uuid
  status        CompanyModuleStatus @default(ACTIVE)
  activatedAt   DateTime            @default(now())
  expiresAt     DateTime?
  configuration Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([companyId, moduleId])
  @@index([companyId, status])
  @@index([moduleId, status])
}

model Branch {
  id               String                   @id @default(uuid()) @db.Uuid
  companyId        String                   @db.Uuid
  code             String                   @db.VarChar(40)
  name             String                   @db.VarChar(140)
  status           RecordStatus             @default(ACTIVE)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  users            User[]
  auditLogs        AuditLog[]
  resources        TenantTestResource[]
  customersOrigin  Customer[]               @relation("CustomerOriginBranch")
  vehiclesOrigin   Vehicle[]                @relation("VehicleOriginBranch")
  vehicleHistory   VehicleHistoryEvent[]
  odometerReadings VehicleOdometerReading[]
  workOrders       WorkOrder[]
  vehicleCheckIns  VehicleCheckIn[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
}

model User {
  id                  String                    @id @default(uuid()) @db.Uuid
  companyId           String                    @db.Uuid
  defaultBranchId     String                    @db.Uuid
  name                String                    @db.VarChar(140)
  email               String                    @db.VarChar(180)
  passwordHash        String
  status              UserStatus                @default(ACTIVE)
  failedLoginAttempts Int                       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?
  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultBranch       Branch                    @relation(fields: [defaultBranchId], references: [id], onDelete: Restrict)
  roles               UserRole[]
  sessions            UserSession[]
  auditLogs           AuditLog[]                @relation("AuditActor")
  vehicleHistory      VehicleHistoryEvent[]     @relation("VehicleHistoryActor")
  vehicleOwnerships   VehicleOwnershipHistory[] @relation("VehicleOwnershipActor")
  odometerReadings    VehicleOdometerReading[]  @relation("VehicleOdometerActor")
  attendedWorkOrders  WorkOrder[]               @relation("WorkOrderAttendant")
  reportedConcerns    CustomerConcern[]         @relation("CustomerConcernReporter")
  createdCheckIns     VehicleCheckIn[]          @relation("VehicleCheckInCreator")

  @@unique([id, companyId])
  @@index([companyId, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String?          @db.Uuid
  code        String           @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(64)
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(120)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, revokedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  branchId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(100)
  metadata    Json?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model TenantTestResource {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  branchId  String   @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId, branchId])
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  originBranchId String? @db.Uuid

  type   CustomerType   @default(INDIVIDUAL)
  status CustomerStatus @default(ACTIVE)

  name      String  @db.VarChar(180)
  tradeName String? @db.VarChar(180)

  document          String? @db.VarChar(30)
  stateRegistration String? @db.VarChar(40)

  email    String? @db.VarChar(180)
  phone    String? @db.VarChar(30)
  whatsapp String? @db.VarChar(30)

  birthDate DateTime? @db.Date
  notes     String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  originBranch Branch? @relation("CustomerOriginBranch", fields: [originBranchId, companyId], references: [id, companyId], onDelete: Restrict)

  addresses         CustomerAddress[]
  vehicles          Vehicle[]
  vehicleOwnerships VehicleOwnershipHistory[]
  workOrders        WorkOrder[]
  vehicleCheckIns   VehicleCheckIn[]

  @@unique([id, companyId])
  @@index([companyId, name])
  @@index([companyId, status])
  @@index([companyId, phone])
  @@index([companyId, whatsapp])
  @@index([companyId, deletedAt])
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum FuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
  GNV
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  AUTOMATED
  OTHER
}

model Vehicle {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  customerId     String  @db.Uuid
  originBranchId String? @db.Uuid

  status VehicleStatus @default(ACTIVE)

  plate   String? @db.VarChar(7)
  renavam String? @db.VarChar(11)
  chassis String? @db.VarChar(17)

  brand   String  @db.VarChar(80)
  model   String  @db.VarChar(120)
  version String? @db.VarChar(120)

  yearManufacture Int?
  yearModel       Int?
  color           String? @db.VarChar(60)

  fuelType     FuelType?
  transmission TransmissionType?
  engine       String?           @db.VarChar(80)
  enginePower  Int?
  bodyType     String?           @db.VarChar(80)
  doors        Int?

  currentMileage Int?
  notes          String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer                  @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  originBranch     Branch?                   @relation("VehicleOriginBranch", fields: [originBranchId, companyId], references: [id, companyId], onDelete: Restrict)
  history          VehicleHistoryEvent[]
  ownerships       VehicleOwnershipHistory[]
  odometerReadings VehicleOdometerReading[]
  workOrders       WorkOrder[]
  vehicleCheckIns  VehicleCheckIn[]

  @@unique([id, companyId])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, brand, model])
  @@index([companyId, originBranchId])
  @@index([companyId, deletedAt])
}

enum VehicleOwnershipType {
  OWNER
  FLEET
  DRIVER
  RESPONSIBLE
  LEASED
  OTHER
}

model VehicleOwnershipHistory {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @db.Uuid
  vehicleId       String               @db.Uuid
  customerId      String               @db.Uuid
  createdByUserId String?              @db.Uuid
  ownershipType   VehicleOwnershipType @default(OWNER)
  validFrom       DateTime
  validUntil      DateTime?
  isCurrent       Boolean              @default(true)
  notes           String?              @db.Text
  createdAt       DateTime             @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle   Vehicle  @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("VehicleOwnershipActor", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, vehicleId, validFrom])
  @@index([companyId, customerId, validFrom])
}

enum VehicleOdometerSource {
  VEHICLE
  VEHICLE_HISTORY
  SERVICE_VISIT
  CHECK_IN
  WORK_ORDER
  INSPECTION
  DELIVERY
  MANUAL
  INTEGRATION
}

model VehicleOdometerReading {
  id         String                @id @default(uuid()) @db.Uuid
  companyId  String                @db.Uuid
  vehicleId  String                @db.Uuid
  branchId   String?               @db.Uuid
  userId     String?               @db.Uuid
  mileage    Int
  recordedAt DateTime
  source     VehicleOdometerSource
  sourceId   String?               @db.VarChar(100)
  notes      String?               @db.Text
  createdAt  DateTime              @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  user    User?   @relation("VehicleOdometerActor", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, vehicleId, recordedAt])
  @@index([companyId, source, sourceId])
}

enum VehicleHistoryEventType {
  VEHICLE_CREATED
  VEHICLE_UPDATED
  MILEAGE_RECORDED
  NOTE
  OWNER_CHANGED
  GENERAL
  WORK_ORDER_OPENED
  CUSTOMER_CONCERN_RECORDED
  CHECK_IN_COMPLETED
  WORK_ORDER_CLOSED_NO_SERVICE
  WORK_ORDER_COMPLETED
  WORK_ORDER_CANCELLED
}

enum VehicleHistorySourceType {
  MANUAL
  SYSTEM
  VEHICLE
  FUTURE_MODULE
}

model VehicleHistoryEvent {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  vehicleId   String  @db.Uuid
  branchId    String? @db.Uuid
  actorUserId String? @db.Uuid

  eventType  VehicleHistoryEventType
  sourceType VehicleHistorySourceType
  sourceId   String?                  @db.VarChar(100)

  title       String   @db.VarChar(180)
  description String?  @db.Text
  mileage     Int?
  eventDate   DateTime
  metadata    Json?
  isManual    Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  actor   User?   @relation("VehicleHistoryActor", fields: [actorUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, vehicleId, eventDate])
  @@index([companyId, vehicleId, eventType])
}

model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @db.Uuid
  customerId String @db.Uuid

  label        String? @db.VarChar(80)
  postalCode   String? @db.VarChar(20)
  street       String  @db.VarChar(180)
  number       String? @db.VarChar(30)
  complement   String? @db.VarChar(120)
  neighborhood String? @db.VarChar(120)
  city         String  @db.VarChar(120)
  state        String  @db.VarChar(40)
  country      String  @default("BR") @db.VarChar(2)

  isPrimary Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, customerId])
  @@index([companyId, city, state])
}

enum WorkOrderPurpose {
  DIAGNOSTIC
  EVALUATION
  MAINTENANCE
  REPAIR
  INSPECTION
  REVISION
  WARRANTY
  COURTESY
  RETURN
  OTHER
}

enum WorkOrderStatus {
  OPEN
  CANCELLED
  CLOSED_NO_SERVICE
  CLOSED
}

enum WorkOrderClosingReason {
  PRICE
  POSTPONED
  NO_AUTHORIZATION
  PART_UNAVAILABLE
  CUSTOMER_WITHDREW
  VEHICLE_REMOVED
  SECOND_OPINION
  OTHER
}

model WorkOrderSequence {
  companyId String   @id @db.Uuid
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

model WorkOrder {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @db.Uuid
  branchId        String                  @db.Uuid
  customerId      String                  @db.Uuid
  vehicleId       String                  @db.Uuid
  attendantUserId String                  @db.Uuid
  number          Int
  purpose         WorkOrderPurpose
  status          WorkOrderStatus         @default(OPEN)
  openedAt        DateTime                @default(now())
  closedAt        DateTime?
  mileageAtEntry  Int?
  notes           String?                 @db.Text
  closingReason   WorkOrderClosingReason?
  closingNotes    String?                 @db.Text
  operationKey    String?                 @db.VarChar(120)
  concernCounter  Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch            @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  customer  Customer          @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  vehicle   Vehicle           @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  attendant User              @relation("WorkOrderAttendant", fields: [attendantUserId, companyId], references: [id, companyId], onDelete: Restrict)
  concerns  CustomerConcern[]
  checkIn   VehicleCheckIn?

  @@unique([id, companyId])
  @@unique([id, companyId, branchId, customerId, vehicleId], map: "WorkOrder_intake_identity_key")
  @@unique([companyId, number])
  @@unique([companyId, operationKey])
  @@index([companyId, status, openedAt])
  @@index([companyId, vehicleId, openedAt])
  @@index([companyId, customerId, openedAt])
  @@index([companyId, branchId, openedAt])
}

enum CustomerConcernPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CustomerConcern {
  id               String                  @id @default(uuid()) @db.Uuid
  companyId        String                  @db.Uuid
  workOrderId      String                  @db.Uuid
  reportedByUserId String                  @db.Uuid
  description      String                  @db.Text
  category         String?                 @db.VarChar(80)
  priority         CustomerConcernPriority @default(NORMAL)
  symptomStartedAt DateTime?
  frequency        String?                 @db.VarChar(120)
  condition        String?                 @db.VarChar(240)
  notes            String?                 @db.Text
  sequence         Int
  reportedAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workOrder  WorkOrder @relation(fields: [workOrderId, companyId], references: [id, companyId], onDelete: Restrict)
  reportedBy User      @relation("CustomerConcernReporter", fields: [reportedByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([companyId, workOrderId, sequence])
  @@index([companyId, workOrderId, reportedAt])
}

enum VehicleCheckInStatus {
  DRAFT
  COMPLETED
  CONFIRMED
  CANCELLED
}

model VehicleCheckIn {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @db.Uuid
  branchId        String               @db.Uuid
  workOrderId     String               @db.Uuid
  vehicleId       String               @db.Uuid
  customerId      String               @db.Uuid
  createdByUserId String               @db.Uuid
  status          VehicleCheckInStatus @default(DRAFT)
  startedAt       DateTime             @default(now())
  completedAt     DateTime?
  confirmedAt     DateTime?
  mileage         Int?
  fuelLevel       Int?
  deliveredBy     String?              @db.VarChar(180)
  generalNotes    String?              @db.Text
  templateVersion Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch    @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  workOrder WorkOrder @relation(fields: [workOrderId, companyId, branchId, customerId, vehicleId], references: [id, companyId, branchId, customerId, vehicleId], onDelete: Restrict, map: "VehicleCheckIn_work_order_fkey")
  vehicle   Vehicle   @relation(fields: [vehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  customer  Customer  @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User      @relation("VehicleCheckInCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([workOrderId, companyId, branchId, customerId, vehicleId], map: "VehicleCheckIn_work_order_key")
  @@index([companyId, vehicleId, startedAt])
  @@index([companyId, status, startedAt])
}
